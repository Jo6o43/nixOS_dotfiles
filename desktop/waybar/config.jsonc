{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 5,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/language",
        "clock",
        "custom/lid-inhibit"
    ],
    "modules-right": [
        "tray", 
        "network", 
        "bluetooth", 
        "temperature", 
        "cpu", 
        "memory", 
        "battery", 
        "wireplumber"
    ],

    "hyprland/workspaces": {
        "format": "<b>{name}</b>",
        "sort-by-number": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "wireplumber": {
        "format": "\udb81\udd7e",
        "format-muted": "\udb81\udd81",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "max-volume": 100,
        "scroll-step": 5
    },

    "battery": {
        "interval": 10,
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": true,
        "tooltip-format": "Battery: {capacity}%\nRemaining Time: {timeTo}",
        "states": {
            "warning": 25,
            "critical": 10
        }
    },

    "memory": { 
        "interval": 30,
        "on-click": "kitty -e top",
        "format": "\uf4bc {used:0.1f}G"
    },

    "cpu": {
    "interval": 10,
    "on-click": "kitty -e top",
    "format": "\uf2db {usage}%"
    },

    "temperature": {
        "format": "{temperatureC}°C "
    },

    "network": {
        "format": "",
        "format-ethernet": "\udb83\udc9d",
        "format-wifi": "{icon}",
        "format-disconnected": "\udb83\udc9c",
        "on-click": "kitty -- nmtui",
        "format-icons": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected"
    },
    
    "bluetooth": {
        "format": "󰂯",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-no-controller": "󰂲",

        "on-click": "kitty -- bluetui",
        "on-click-right": "bash -c 'if bluetoothctl show | grep -q \"Powered: yes\"; then bluetoothctl power off; else bluetoothctl power on; fi'",

        "tooltip": true,
        "tooltip-format": "{controller_alias}\n{controller_address}",
        "tooltip-format-on": "Bluetooth: On",
        "tooltip-format-off": "Bluetooth: Off",
        "tooltip-format-disabled": "Bluetooth: Disabled",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },


    "hyprland/language": {
        "format": "{}",
        "format-en": "us",
        "format-pt": "pt",
        "keyboard-name": "at-translated-set-2-keyboard",
        "on-click": "hyprctl switchxkblayout all next",
        "tooltip": true,
        "tooltip-format": "{long}"
    },

    "tray": {
        "icon-size": 10,
        "spacing": 10
    }

}